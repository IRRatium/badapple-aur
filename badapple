#!/usr/bin/env python3
import os
import sys
import time
import subprocess
import shutil
import signal
import io
from PIL import Image

VIDEO_PATH = "/usr/share/badapple/bad_apple.mp4"

ORIG_WIDTH = 480
ORIG_HEIGHT = 360
FPS = 30.0

if not os.path.exists(VIDEO_PATH):
    sys.exit(f"Error: video not found at {VIDEO_PATH} — reinstall the package")

print("==> Starting audio...")
mpv_proc = subprocess.Popen(
    ["mpv", "--no-video", VIDEO_PATH],
    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
)

print("\033c", end="")
sys.stdout.write("\033[?25l")
sys.stdout.flush()

ffmpeg_cmd = [
    "ffmpeg", "-i", VIDEO_PATH,
    "-f", "image2pipe", "-pix_fmt", "rgb24",
    "-vcodec", "rawvideo", "-", "-y"
]
ffmpeg_proc = subprocess.Popen(
    ffmpeg_cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
)

frame_size = ORIG_WIDTH * ORIG_HEIGHT * 3


def cleanup(signum=None, frame=None):
    sys.stdout.write("\033[?25h\033c")
    sys.stdout.flush()
    try:
        ffmpeg_proc.terminate()
        mpv_proc.terminate()
    except:
        pass
    sys.exit(0)


signal.signal(signal.SIGINT, cleanup)
signal.signal(signal.SIGTERM, cleanup)

start_time = time.time()
frame_count = 0
prev_term_size = (0, 0)

try:
    while True:
        raw_frame = ffmpeg_proc.stdout.read(frame_size)
        if not raw_frame or len(raw_frame) != frame_size:
            break

        frame_count += 1

        term_cols, term_lines = shutil.get_terminal_size()

        if (term_cols, term_lines) != prev_term_size:
            sys.stdout.write("\033[2J")
            prev_term_size = (term_cols, term_lines)

        max_w = term_cols
        max_h = term_lines - 1
        char_ratio = 0.5
        w_by_width = max_w
        h_by_width = int(max_w * (ORIG_HEIGHT / ORIG_WIDTH) * char_ratio)
        w_by_height = int(max_h * (ORIG_WIDTH / ORIG_HEIGHT) / char_ratio)
        h_by_height = max_h
        if h_by_width <= max_h:
            target_width, target_height = w_by_width, h_by_width
        else:
            target_width, target_height = w_by_height, h_by_height
        target_width = max(10, target_width)
        target_height = max(5, target_height)

        pad_top = (max_h - target_height) // 2
        pad_left = (max_w - target_width) // 2

        img = Image.frombytes("RGB", (ORIG_WIDTH, ORIG_HEIGHT), raw_frame)
        buf = io.BytesIO()
        img.save(buf, format="PNG")
        png_data = buf.getvalue()

        aic_proc = subprocess.run(
            ["ascii-image-converter", "-", "-d",
             f"{target_width},{target_height}"],
            input=png_data, capture_output=True
        )
        ascii_lines = aic_proc.stdout.decode(
            "utf-8", errors="replace").splitlines()

        prefix = " " * pad_left
        out = "\033[H"
        for _ in range(pad_top):
            out += "\033[K\n"
        for line in ascii_lines:
            out += prefix + line + "\033[K\n"
        out += "\033[J"

        expected_time = start_time + (frame_count / FPS)
        now = time.time()
        if expected_time > now:
            time.sleep(expected_time - now)

        sys.stdout.write(out)
        sys.stdout.flush()

except Exception:
    cleanup()

cleanup()
