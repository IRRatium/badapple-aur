#!/bin/bash
# Original code: Nguyen Khac Trung Kien
# Fork by: Felipe Avelar (Python Perfect Sync + Centered Video Mod)

SYSTEM_DATA="/usr/share/badapple"
FRAMES_FILE="$SYSTEM_DATA/frames.txt"
MP3="$SYSTEM_DATA/bad_apple.mp3"

if ! command -v mpv &>/dev/null; then
    echo "Error: mpv is not installed"
    exit 1
fi
if [[ ! -f "$FRAMES_FILE" ]]; then
    echo "Error: frames.txt not found at $SYSTEM_DATA — reinstall the package"
    exit 1
fi
if [[ ! -f "$MP3" ]]; then
    echo "Error: audio not found at $MP3 — reinstall the package"
    exit 1
fi

printf "\033c"
tput civis

mpv "$MP3" > /dev/null 2>&1 &
MPV_PID=$!
trap 'tput cnorm; kill $MPV_PID 2>/dev/null || true; printf "\033c"' EXIT INT TERM

export FRAMES_FILE

python3 << 'PYEOF'
import os, sys, time, shutil

frames_file = os.environ.get('FRAMES_FILE')
FRAME_HEIGHT = 36  # Фиксированная высота кадра
FRAME_WIDTH = 96   # Фиксированная ширина кадра
fps = 30.0

try:
    with open(frames_file, "r", encoding="utf-8") as f:
        all_lines = f.read().splitlines()
except Exception as e:
    sys.exit(f"Error reading frames: {e}")

total_frames = len(all_lines) // FRAME_HEIGHT

if total_frames == 0:
    sys.exit("Error: No frames found in file.")

start_time = time.time()

for i in range(total_frames):
    start_line = i * FRAME_HEIGHT
    end_line = start_line + FRAME_HEIGHT
    frame_lines = all_lines[start_line:end_line]

    term_cols, term_lines = shutil.get_terminal_size()
    pad_y = max(0, (term_lines - FRAME_HEIGHT) // 2)
    pad_x = max(0, (term_cols - FRAME_WIDTH) // 2)

    out = '\033[H' + ('\n' * pad_y)
    left_spaces = ' ' * pad_x
    for line in frame_lines:
        out += left_spaces + line + '\033[K\n'
    out += '\033[J'

    expected_time = start_time + (i / fps)
    current_time = time.time()
    if expected_time > current_time:
        time.sleep(expected_time - current_time)

    sys.stdout.write(out)
    sys.stdout.flush()
PYEOF
